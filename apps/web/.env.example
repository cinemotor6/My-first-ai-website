# --- Data providers -----------------------------------------------------
# "mock" is the only implemented provider right now (no signup, no API key,
# illustrative numbers). See src/lib/*/providers/index.ts to add a real one.
MARKET_DATA_PROVIDER=mock
NEWS_PROVIDER=mock
MACRO_PROVIDER=mock

# --- Quant service --------------------------------------------------------
# Base URL of apps/quant-api. The Next.js API routes proxy to this.
QUANT_API_URL=http://localhost:8000

# --- Auth (Clerk) ----------------------------------------------------------
# Optional for now. Leave both unset and the app runs unauthenticated with
# mock data (a fixed "demo-user" owns the sample portfolio). Set both to
# enable real sign-in — get keys from https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (not wired up yet) -------------------------------------------
# Reserved for when portfolio storage moves off the in-memory mock
# repository (src/lib/portfolio/providers/mock-repository.ts) onto Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
