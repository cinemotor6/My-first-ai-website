# --- Data providers -----------------------------------------------------
# All of these default to "live" — real data via keyless public APIs
# (Yahoo Finance for market data/news, Frankfurter/ECB for FX), with an
# automatic, transparent fallback to mock/sample data if the live call
# fails for any reason (network down, rate limited, unsupported symbol).
# No API key or signup needed for any of it. Override to force a specific
# mode:
#   MARKET_DATA_PROVIDER=mock      pure mock, never touches the network
#   MARKET_DATA_PROVIDER=yahoo     pure live, no fallback (fails loudly)
#   MARKET_DATA_PROVIDER=live      live with mock fallback (default)
# Same pattern for NEWS_PROVIDER (mock/yahoo/live) and FX_RATE_PROVIDER
# (mock/frankfurter/live). MACRO_PROVIDER only has "mock" today.
# See src/lib/*/providers/index.ts to add another real source.
MARKET_DATA_PROVIDER=live
NEWS_PROVIDER=live
MACRO_PROVIDER=mock
FX_RATE_PROVIDER=live

# --- Quant service --------------------------------------------------------
# Base URL of apps/quant-api. The Next.js API routes proxy to this.
QUANT_API_URL=http://localhost:8000

# --- Auth (Clerk) ----------------------------------------------------------
# Optional for now. Leave both unset and the app runs unauthenticated with
# mock data (a fixed "demo-user" owns the sample portfolio). Set both to
# enable real sign-in — get keys from https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (not wired up yet) -------------------------------------------
# Reserved for when portfolio storage moves off the in-memory mock
# repository (src/lib/portfolio/providers/mock-repository.ts) onto Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
